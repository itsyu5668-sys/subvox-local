<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Subvox Local</string>
	<key>CFBundleDisplayName</key>
	<string>Subvox Local</string>
	<key>CFBundleIdentifier</key>
	<string>com.subvox.local</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleExecutable</key>
	<string>SubvoxLocal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Dock icon: ON. The app used to be LSUIElement (menu-bar only,
	     no Dock icon), and that is why re-opening it did nothing visible:
	     double-clicking a running menu-bar app just activates it, and
	     with the window closed there was nothing to click. The app
	     still has its menu-bar ✳, but now it also has a Dock icon, so
	     clicking the app always brings its window forward. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Subvox Local reads your lips from the webcam to turn silent mouthing into text. Video never leaves your Mac.</string>
	<!-- Input Monitoring + Accessibility cannot be declared here; macOS
	     prompts for them when the app installs its hotkey / paste tap.
	     See packaging/README.md troubleshooting. -->
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
